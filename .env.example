# Copia este archivo como `.env` y completa con tus valores reales.
APP_NAME=NutriAPI
APP_ENV=local
APP_VERSION=0.1.0

MONGO_URI=mongodb://localhost:27017
MONGO_DB=nutriapp

# Genera secretos fuertes en prod
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ALG=HS256
JWT_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=14

# CORS (JSON o CSV). En prod: especifica dominios explícitos
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8080"]

# Firebase Admin
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Notificaciones
NOTIFY_BEFORE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/oauth/callback
GOOGLE_SCOPES=["https://www.googleapis.com/auth/calendar"]
APP_OAUTH_SUCCESS_REDIRECT=vitta://oauth/success

# --- Stripe (payments: specs 077-080). All three keys must be set or every
#     payment endpoint 503s (settings.stripe_native_enabled).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx  # from `stripe listen` (local) or the dashboard webhook
STRIPE_PRICE_PRO=price_xxx       # recurring Price id for the Pro plan (subscriptions)
BILLING_PROVIDER=mock            # mock | stripe  (the hosted-checkout redirect path)
STRIPE_CONNECT_COUNTRY=MX
